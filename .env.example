# Copy this file to .env and fill it in.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: your server's ID. Commands sync to it instantly; without it they're global
# and can take up to an hour to appear the first time.
GUILD_ID=

# Optional: members with this role (or Manage Server permission) can edit anyone's character.
JUDGE_ROLE=Judge

# Optional: where the SQLite database lives.
# DATABASE_PATH=data/acks.db
